# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG – NHÀ NGHỈ THA PHƯƠNG (CLASSIC LUXURY HOTEL BOOKING)
# Sao chép file này thành .env.local khi phát triển ở localhost
# ==============================================================================

# 1. URL Website công khai (Khi dev dùng localhost, khi lên Vercel dùng domain Vercel hoặc domain riêng)
VITE_PUBLIC_SITE_URL=http://localhost:5173

# 2. Cấu hình kết nối Supabase (Lấy trong Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 3. Cho phép công cụ tìm kiếm lập chỉ mục (Đặt "false" trên domain thử nghiệm .vercel.app, đặt "true" khi gắn domain chính thức)
VITE_ALLOW_INDEXING=false

# 4. Cấu hình Google Analytics 4 / Tag Manager (Tùy chọn)
VITE_GA_MEASUREMENT_ID=

# ==============================================================================
# BIẾN MÔI TRƯỜNG BACKEND (Chỉ cấu hình trong Supabase Edge Functions Secrets, KHÔNG đưa vào VITE_)
# ==============================================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL="Nhà Nghỉ Tha Phương <onboarding@resend.dev>"
# HOST_NOTIFICATION_EMAIL=huynhduykhanh0406@gmail.com
